{
  "rules": {
    "rooms": {
      "$code": {
        ".write": "auth != null && data.child('meta/host').val() === auth.uid && !newData.exists()",
        "meta": {
          ".read": "auth != null",
          ".write": "auth != null && (!data.exists() || data.child('host').val() === auth.uid)"
        },
        "state": {
          ".read": "auth != null",
          ".write": "auth != null && root.child('rooms').child($code).child('meta/host').val() === auth.uid"
        },
        "players": {
          ".read": "auth != null",
          "$uid": {
            ".write": "auth != null && (auth.uid === $uid || root.child('rooms').child($code).child('meta/host').val() === auth.uid)",
            "name": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 30" }
          }
        },
        "lead": {
          ".read": "auth != null",
          "$uid": {
            ".write": "auth != null && (auth.uid === $uid || root.child('rooms').child($code).child('meta/host').val() === auth.uid)"
          }
        },
        "suggest": {
          ".read": "auth != null && root.child('rooms').child($code).child('meta/host').val() === auth.uid",
          ".write": "auth != null && root.child('rooms').child($code).child('meta/host').val() === auth.uid",
          "$team": {
            ".read": "auth != null && root.child('rooms').child($code).child('players').child(auth.uid).child('team').val() === $team",
            "$uid": {
              ".write": "auth != null && auth.uid === $uid && root.child('rooms').child($code).child('players').child(auth.uid).child('team').val() === $team"
            }
          }
        },
        "guesses": {
          ".read": "auth != null && root.child('rooms').child($code).child('meta/host').val() === auth.uid",
          ".write": "auth != null && root.child('rooms').child($code).child('meta/host').val() === auth.uid",
          "$team": {
            ".read": "auth != null && root.child('rooms').child($code).child('players').child(auth.uid).child('team').val() === $team",
            ".write": "auth != null && root.child('rooms').child($code).child('state/teams').child($team).child('leader').val() === auth.uid && root.child('rooms').child($code).child('state/phase').val() === 'question' && data.child('locked').val() !== true"
          }
        }
      }
    }
  }
}
